# ===============================================
# Farg'ona Viloyat Davomat Tizimi - Namunaviy .env
# 2026-2027 O'quv yili
# ===============================================

# Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=your_bot_token_here

# Port
PORT=3000

# PostgreSQL / Supabase ma'lumotlar bazasi URL
# Masalan: postgresql://postgres.xxxx:parol@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=your_postgres_connection_string_here

# Google Sheets integratsiyasi (ixtiyoriy)
GOOGLE_SCRIPT_URL=

# Hisobotlar yuboriladigan Telegram guruh/kanal ID
REPORT_GROUP_ID=-1003662758005

# Ota-onalar xabarnoma boti (ixtiyoriy)
PARENT_BOT_TOKEN=

# Gemini AI kaliti (ixtiyoriy)
GEMINI_API_KEY=

# Eskiz SMS xizmati (ixtiyoriy)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# VAPID Web Push xabarnomalari (ixtiyoriy)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
